  "backends": [
    {
      "id": "native-linux",
      "displayName": "Native Linux",
      "kind": "native",
      "launchMode": "local",
      "hostPlatforms": ["linux"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "blocked",
      "launchVerdict": "deny",
      "authorization": "none",
      "reasonCode": "NO_OFFICIAL_LINUX_CLIENT_OR_VANGUARD_PATH",
      "summary": "Riot does not support a native Linux League client and has not published an authorized Vanguard path for Linux.",
      "sourceIds": ["riot-system-requirements", "riot-vanguard-linux", "riot-patch-14-9", "riot-vanguard-on-demand"],
      "safetyNotes": [
        "Do not emulate, disable, spoof, conceal, or bypass Vanguard.",
        "Do not install third-party Vanguard DLLs, drivers, or kernel modules."
      ]
    },
    {
      "id": "native-bsd",
      "displayName": "Native BSD",
      "kind": "native",
      "launchMode": "local",
      "hostPlatforms": ["freebsd", "openbsd", "netbsd", "dragonflybsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "blocked",
      "launchVerdict": "deny",
      "authorization": "none",
      "reasonCode": "NO_OFFICIAL_BSD_CLIENT_OR_VANGUARD_PATH",
      "summary": "Riot publishes neither a native BSD League client nor an authorized Vanguard path for a supported BSD system.",
      "sourceIds": ["riot-system-requirements", "riot-vanguard-linux", "riot-patch-14-9", "riot-vanguard-on-demand"],
      "safetyNotes": [
        "Linux compatibility layers do not establish BSD support or anti-cheat authorization.",
        "Do not install third-party Vanguard DLLs, drivers, or kernel modules."
      ]
    },
    {
      "id": "wine",
      "displayName": "Wine",
      "kind": "translation",
      "launchMode": "local",
      "hostPlatforms": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "blocked",
      "launchVerdict": "deny",
      "authorization": "none",
      "reasonCode": "VANGUARD_DRIVER_REQUIREMENTS_UNSATISFIED",
      "summary": "Riot states that the Wine-based League implementation cannot satisfy Vanguard's driver requirements.",
      "sourceIds": ["riot-vanguard-linux", "riot-patch-14-9", "winehq-about"],
      "safetyNotes": [
        "Windows API compatibility is not equivalent to Vanguard kernel-driver compatibility.",
        "Never patch Riot binaries or add untrusted DLL overrides to evade the launch gate."
      ]
    },
    {
      "id": "proton",
      "displayName": "Proton",
      "kind": "translation",
      "launchMode": "local",
      "hostPlatforms": ["linux"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "blocked",
      "launchVerdict": "deny",
      "authorization": "none",
      "reasonCode": "VANGUARD_DRIVER_REQUIREMENTS_UNSATISFIED",
      "summary": "Proton is Wine-based and does not provide an authorized way to satisfy the required Vanguard Windows driver and host-attestation path.",
      "sourceIds": ["riot-vanguard-linux", "riot-patch-14-9", "valve-proton"],
      "safetyNotes": [
        "A custom Proton build cannot replace Riot authorization or Vanguard's required trust boundary.",
        "Never use launch flags or patches intended to conceal the host environment."
      ]
    },
    {
      "id": "dockur-qemu",
      "displayName": "dockur/windows on QEMU/KVM",
      "kind": "virtual-machine",
      "launchMode": "local",
      "hostPlatforms": ["linux"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "blocked",
      "launchVerdict": "deny",
      "authorization": "none",
      "reasonCode": "VANGUARD_VIRTUAL_MACHINE_UNSUPPORTED",
      "summary": "dockur/windows runs Windows in a QEMU virtual machine; Riot states that Vanguard is not supported in virtual machines.",
      "sourceIds": ["riot-vm-policy", "riot-vanguard-linux", "dockur-windows", "dockur-environment"],
      "safetyNotes": [
        "Do not hide virtualization, alter device identity, or modify boot evidence.",
        "Container packaging does not turn the Windows guest into a physical supported host."
      ]
    },
    {
      "id": "bhyve",
      "displayName": "Windows on bhyve",
      "kind": "virtual-machine",
      "launchMode": "local",
      "hostPlatforms": ["freebsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "blocked",
      "launchVerdict": "deny",
      "authorization": "none",
      "reasonCode": "VANGUARD_VIRTUAL_MACHINE_UNSUPPORTED",
      "summary": "A Windows bhyve guest remains a virtual machine, which Riot does not support for Vanguard.",
      "sourceIds": ["riot-vm-policy", "riot-vanguard-linux", "freebsd-bhyve"],
      "safetyNotes": [
        "Do not hide the hypervisor or spoof hardware and boot identity.",
        "PCI passthrough does not establish Riot support for the virtual-machine trust boundary."
      ]
    },
    {
      "id": "physical-windows-remote",
      "displayName": "Physical Windows PC with remote streaming",
      "kind": "remote-physical-windows",
      "launchMode": "remote",
      "hostPlatforms": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "handoff-only",
      "launchVerdict": "deny",
      "authorization": "unverified",
      "reasonCode": "REMOTE_HANDOFF_NOT_A_LOCAL_COMPATIBILITY_PATH",
      "summary": "A separately managed physical Windows computer may meet Riot's Windows requirements, but remote-control and streaming integration is not an authorized local Linux or BSD gameplay backend in this manifest.",
      "sourceIds": ["riot-system-requirements", "riot-vanguard-on-demand", "sunshine-docs", "sunshine-raw-input", "sunshine-getting-started", "libvirtualhid-driver-release", "sunshine-raw-input-preview", "moonlight-qt", "moonlight-embedded"],
      "safetyNotes": [
        "The Windows machine must independently satisfy Riot's current requirements and policies.",
        "Do not forward credentials through LeagueBridge or claim that streaming makes Linux or BSD natively supported.",
        "Sunshine's vendor-provided Raw Input driver is an external, unvalidated candidate; it is not Riot authorization and must not be replaced with an unapproved input tool."
      ]
    },
    {
      "id": "physical-macos-remote",
      "displayName": "Physical macOS computer with remote streaming",
      "kind": "remote-physical-macos",
      "launchMode": "remote",
      "hostPlatforms": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "handoff-only",
      "launchVerdict": "deny",
      "authorization": "unverified",
      "reasonCode": "MACOS_REMOTE_HANDOFF_EXPERIMENTAL_AND_UNVALIDATED",
      "summary": "A separately managed physical Mac may run Riot's native macOS client, while Sunshine documents macOS host support as experimental; LeagueBridge has no validated macOS capture, input, audio, gamepad, or gameplay evidence.",
      "sourceIds": ["riot-system-requirements", "riot-macos-embedded-vanguard", "sunshine-docs", "moonlight-qt", "moonlight-embedded"],
      "safetyNotes": [
        "League must run through Riot's unmodified native macOS client on the physical Mac; this route does not make Linux or BSD natively supported.",
        "Sunshine's macOS host behavior is experimental and gamepad support is unavailable; do not treat a successful handoff as Riot endorsement or gameplay validation."
      ]
    },
    {
      "id": "hardware-kvm-remote",
      "displayName": "Hardware KVM with physical Windows or macOS host",
      "kind": "remote-hardware-kvm",
      "launchMode": "remote",
      "hostPlatforms": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "handoff-only",
      "launchVerdict": "deny",
      "authorization": "unverified",
      "reasonCode": "HARDWARE_KVM_HANDOFF_UNVALIDATED",
      "summary": "A hardware KVM may expose a physical Windows or Mac display, HDMI audio, and USB HID path to a Linux or BSD user, but the device, host, audio path, and League/Vanguard interaction remain unvalidated.",
      "sourceIds": ["riot-system-requirements", "riot-vanguard-on-demand", "riot-vanguard-faq", "pikvm-api", "pikvm-usb", "pikvm-auth", "pikvm-audio"],
      "safetyNotes": [
        "The League client and Vanguard must remain on an independently supported physical Windows PC or Mac; this is not a native Linux/BSD backend.",
        "Use the KVM's authenticated vendor UI and physical USB HID path; do not add USB/IP, software input interception, DLL overrides, or Vanguard changes.",
        "For full audio/video validation, use a vendor-documented HDMI-audio/WebRTC-capable model and verify audio; VNC or DIY capture may omit audio.",
        "A KVM device is only a manual candidate until route-bound video, audio, input, latency, and Practice Tool evidence exists."
      ]
    },
    {
      "id": "dual-boot",
      "displayName": "Dual boot into Windows",
      "kind": "dual-boot",
      "launchMode": "handoff",
      "hostPlatforms": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"],
      "hostArchitectures": ["amd64", "arm64"],
      "state": "handoff-only",
      "launchVerdict": "deny",
      "authorization": "unverified",
      "reasonCode": "REBOOT_HANDOFF_NOT_A_LOCAL_COMPATIBILITY_PATH",
      "summary": "Booting a supported physical Windows installation is outside LeagueBridge's Linux or BSD launch process; the Windows installation must pass Riot's requirements on its own.",
      "sourceIds": ["riot-system-requirements", "riot-vanguard-on-demand", "microsoft-bcdboot"],
      "safetyNotes": [
        "Treat this only as guidance to leave the current operating system, not as a Linux or BSD launch backend.",
        "LeagueBridge must not weaken Secure Boot, TPM, VBS, HVCI, IOMMU, or other Windows security requirements."
      ]
    }
