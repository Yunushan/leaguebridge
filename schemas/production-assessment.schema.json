{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yunushan/leaguebridge/schemas/production-assessment.schema.json",
  "title": "Live full production engineering assessment observation",
  "description": "Output-only contract for the data payload of readiness verify-production --json (the CLI wraps it in an envelope). This document is not accepted as evidence input, a signed receipt, a later-state guarantee, or gameplay authorization. Only live verifiers may derive scores and bind the release identity, evidence, policy, and time windows. JSON Schema cannot establish those facts or enforce score arithmetic and temporal order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "observed_at", "evidence_expires_at", "repository_score", "release_score", "score", "criteria"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "tree", "release_id", "release_run_id", "release_run_attempt", "ci_run_id", "ci_run_attempt", "scorecard_sha256", "scorecard_expires_at", "assets"],
      "properties": {
        "version": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "commit": { "$ref": "#/$defs/objectId" },
        "tree": { "$ref": "#/$defs/objectId" },
        "release_id": { "$ref": "#/$defs/positiveInteger" },
        "release_run_id": { "$ref": "#/$defs/positiveInteger" },
        "release_run_attempt": { "$ref": "#/$defs/positiveInteger" },
        "ci_run_id": { "$ref": "#/$defs/positiveInteger" },
        "ci_run_attempt": { "$ref": "#/$defs/positiveInteger" },
        "scorecard_sha256": { "$ref": "#/$defs/sha256" },
        "scorecard_expires_at": { "type": "string", "format": "date-time" },
        "assets": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            { "$ref": "#/$defs/checksumsAsset" },
            { "$ref": "#/$defs/dragonflyAmd64Asset" },
            { "$ref": "#/$defs/freebsdAmd64Asset" },
            { "$ref": "#/$defs/freebsdArm64Asset" },
            { "$ref": "#/$defs/linuxAmd64Asset" },
            { "$ref": "#/$defs/linuxArm64Asset" },
            { "$ref": "#/$defs/netbsdAmd64Asset" },
            { "$ref": "#/$defs/netbsdArm64Asset" },
            { "$ref": "#/$defs/openbsdAmd64Asset" },
            { "$ref": "#/$defs/openbsdArm64Asset" }
          ],
          "items": false
        }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "evidence_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest applicable expiry reported by the assessor; this does not certify that mutable publication or revocation state will remain unchanged."
    },
    "repository_score": { "const": 74 },
    "release_score": { "const": 83 },
    "score": { "type": "integer", "minimum": 83, "maximum": 100 },
    "criteria": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/upstreamAuthorization" },
        { "$ref": "#/$defs/nativeIntegration" },
        { "$ref": "#/$defs/physicalBSDSmoke" },
        { "$ref": "#/$defs/independentAudit" },
        { "$ref": "#/$defs/nativePackages" },
        { "$ref": "#/$defs/nativePackageSmoke" }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "score": { "const": 100 } }, "required": ["score"] },
      "then": {
        "properties": {
          "repository_score": { "const": 74 },
          "release_score": { "const": 83 },
          "criteria": {
            "prefixItems": [
              { "properties": { "status": { "const": "verified" } } },
              { "properties": { "status": { "const": "verified" } } },
              { "properties": { "status": { "const": "verified" } } },
              { "properties": { "status": { "const": "verified" } } },
              { "properties": { "status": { "const": "verified" } } },
              { "properties": { "status": { "const": "verified" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "archiveAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": { "type": "string", "pattern": "^leaguebridge_(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)_(?:linux|freebsd|openbsd|netbsd|dragonfly)_(?:amd64|arm64)\\.tar\\.gz$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "checksumsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes"],
      "properties": { "name": { "const": "checksums.txt" }, "sha256": { "$ref": "#/$defs/sha256" }, "size_bytes": { "$ref": "#/$defs/positiveInteger" } }
    },
    "dragonflyAmd64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_dragonfly_amd64\\.tar\\.gz$" } } }] },
    "freebsdAmd64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_freebsd_amd64\\.tar\\.gz$" } } }] },
    "freebsdArm64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_freebsd_arm64\\.tar\\.gz$" } } }] },
    "linuxAmd64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_linux_amd64\\.tar\\.gz$" } } }] },
    "linuxArm64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_linux_arm64\\.tar\\.gz$" } } }] },
    "netbsdAmd64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_netbsd_amd64\\.tar\\.gz$" } } }] },
    "netbsdArm64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_netbsd_arm64\\.tar\\.gz$" } } }] },
    "openbsdAmd64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_openbsd_amd64\\.tar\\.gz$" } } }] },
    "openbsdArm64Asset": { "allOf": [{ "$ref": "#/$defs/archiveAsset" }, { "properties": { "name": { "pattern": "_openbsd_arm64\\.tar\\.gz$" } } }] },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "weight", "evidence_type", "verifier_id", "points", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "weight": { "type": "integer" },
        "evidence_type": { "type": "string" },
        "verifier_id": { "type": "string" },
        "points": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["verified", "missing_evidence"] },
        "missing_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "missing_evidence" } }, "required": ["status"] },
          "then": { "required": ["missing_evidence"], "properties": { "points": { "const": 0 } } },
          "else": { "not": { "required": ["missing_evidence"] } }
        }
      ]
    },
    "upstreamAuthorization": {
      "allOf": [
        { "$ref": "#/$defs/criterion" },
        { "properties": { "id": { "const": "architecture-upstream-authorization" }, "name": { "const": "Authorized upstream extension contract" }, "weight": { "const": 2 }, "evidence_type": { "const": "vendor-authorization-v1" }, "verifier_id": { "const": "riot-linux-bsd-authorization-v1" }, "points": { "enum": [0, 2] } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "points": { "const": 2 } } } }
      ]
    },
    "nativeIntegration": {
      "allOf": [
        { "$ref": "#/$defs/criterion" },
        { "properties": { "id": { "const": "implementation-native-validated-integration" }, "name": { "const": "Native validated platform integration" }, "weight": { "const": 3 }, "evidence_type": { "const": "native-runtime-attestation-v2" }, "verifier_id": { "const": "native-integration-v2" }, "points": { "enum": [0, 3] } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "points": { "const": 3 } } } }
      ]
    },
    "physicalBSDSmoke": {
      "allOf": [
        { "$ref": "#/$defs/criterion" },
        { "properties": { "id": { "const": "tests-native-bsd-physical-smoke" }, "name": { "const": "Native BSD and physical-hardware smoke tests" }, "weight": { "const": 5 }, "evidence_type": { "const": "native-runtime-attestation-v2" }, "verifier_id": { "const": "native-bsd-physical-smoke-v2" }, "points": { "enum": [0, 5] } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "points": { "const": 5 } } } }
      ]
    },
    "independentAudit": {
      "allOf": [
        { "$ref": "#/$defs/criterion" },
        { "properties": { "id": { "const": "security-independent-audit-closed" }, "name": { "const": "Closed independent audit findings" }, "weight": { "const": 2 }, "evidence_type": { "const": "independent-audit-v1" }, "verifier_id": { "const": "independent-audit-v1" }, "points": { "enum": [0, 2] } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "points": { "const": 2 } } } }
      ]
    },
    "nativePackages": {
      "allOf": [
        { "$ref": "#/$defs/criterion" },
        { "properties": { "id": { "const": "packaging-native-os-packages" }, "name": { "const": "Native OS packages" }, "weight": { "const": 3 }, "evidence_type": { "const": "package-attestation-v1" }, "verifier_id": { "const": "native-packages-v1" }, "points": { "enum": [0, 3] } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "points": { "const": 3 } } } }
      ]
    },
    "nativePackageSmoke": {
      "allOf": [
        { "$ref": "#/$defs/criterion" },
        { "properties": { "id": { "const": "packaging-install-uninstall-native-smoke" }, "name": { "const": "Install/uninstall and native smoke evidence" }, "weight": { "const": 2 }, "evidence_type": { "const": "native-runtime-attestation-v2" }, "verifier_id": { "const": "install-native-smoke-v2" }, "points": { "enum": [0, 2] } } },
        { "if": { "properties": { "status": { "const": "verified" } } }, "then": { "properties": { "points": { "const": 2 } } } }
      ]
    }
  }
}
