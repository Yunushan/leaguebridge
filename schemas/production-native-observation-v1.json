    },
    {
      "if": {
        "properties": {
          "cell": {
            "properties": {
              "goos": {
                "const": "linux"
              }
            },
            "required": [
              "goos"
            ]
          }
        },
        "required": [
          "cell"
        ]
      },
      "then": {
        "properties": {
          "native_kernel": {
            "const": "Linux"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cell": {
            "properties": {
              "goos": {
                "const": "freebsd"
              }
            },
            "required": [
              "goos"
            ]
          }
        },
        "required": [
