    {
      "if": {
        "properties": {
          "cell": {
            "properties": {
              "goos": {
                "const": "dragonfly"
              }
            },
            "required": [
              "goos"
            ]
          }
        },
        "required": [
          "cell"
        ]
      },
      "then": {
        "properties": {
          "native_kernel": {
            "const": "DragonFly"
          }
        }
      }
    }
  ],
  "$comment": "The Go verifier enforces whole-second UTC timestamps, expiration at most 30 days after creation, total artifact bytes at most 1073741824, unique raw artifact digests/file identities, exact archive filename binding, canonical JSON and base64url bytes, duplicate-key rejection, and authenticated policy/signatures. JSON Schema alone does not enforce these cross-field and byte-level invariants."
}
