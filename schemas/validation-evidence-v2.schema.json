{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaguebridge.dev/schemas/validation-evidence-v2.schema.json",
  "title": "LeagueBridge authenticated validation-evidence set payload",
  "description": "Schema version 2 binds one physical-windows-remote or physical-macos-remote validation run to the exact bytes of its three schema-v1 records and the production reviewer policy that must authenticate it. This payload contains observations and bindings only; scores, gates, passed flags, and launch authorization are deliberately absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "set_id",
    "validation_run_id",
    "route_id",
    "test_profile_id",
    "policy_id",
    "created_at",
    "expires_at",
    "manifest_as_of",
    "manifest_sha256",
    "host_platform",
    "host_architecture",
    "client_platform",
    "client_architecture",
    "host_record_sha256",
    "client_record_sha256",
    "session_record_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "https://leaguebridge.dev/schemas/validation-evidence-v2.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "set_id": {
      "type": "string",
      "pattern": "^set-[a-f0-9]{32}$"
    },
    "validation_run_id": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{32}$"
    },
    "route_id": {
      "enum": ["physical-windows-remote", "physical-macos-remote"]
    },
    "test_profile_id": {
      "const": "remote-play-v1"
    },
    "policy_id": {
      "$ref": "#/$defs/policyID"
    },
    "created_at": {
      "$ref": "#/$defs/canonicalTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/canonicalTimestamp"
    },
    "manifest_as_of": {
      "$ref": "#/$defs/canonicalDate"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "host_platform": {
      "enum": ["windows", "macos"]
    },
    "host_architecture": {
      "enum": ["amd64", "arm64"]
    },
    "client_platform": {
      "enum": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"]
    },
    "client_architecture": {
      "enum": ["amd64", "arm64"]
    },
    "host_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "client_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "session_record_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "canonicalDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "policyID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "route_id": { "const": "physical-windows-remote" } },
        "required": ["route_id"]
      },
      "then": {
        "properties": {
          "host_platform": { "const": "windows" },
          "host_architecture": { "const": "amd64" }
        }
      }
    },
    {
      "if": {
        "properties": { "route_id": { "const": "physical-macos-remote" } },
        "required": ["route_id"]
      },
      "then": {
        "properties": {
          "host_platform": { "const": "macos" },
          "host_architecture": { "enum": ["amd64", "arm64"] }
        }
      }
    },
    {
      "if": {
        "properties": { "client_platform": { "const": "dragonflybsd" } },
        "required": ["client_platform"]
      },
      "then": {
        "properties": { "client_architecture": { "const": "amd64" } }
      }
    }
  ]
}
