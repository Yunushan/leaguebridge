{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaguebridge.dev/schemas/readiness-promotion-v4.schema.json",
  "title": "LeagueBridge authenticated remote-readiness promotion result",
  "description": "Schema version 4 is a derived result for one route-bound remote client cell. It is valid only when produced by the application from an authenticated validation-evidence v2 VerifiedSet; this JSON document is not itself a trust root, launch authorization, or proof of local Linux/BSD League support.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "evidence_type",
    "promotion_boundary",
    "set_id",
    "validation_run_id",
    "route_id",
    "test_profile_id",
    "policy_id",
    "created_at",
    "expires_at",
    "manifest_as_of",
    "manifest_sha256",
    "host_platform",
    "host_architecture",
    "client_platform",
    "client_architecture",
    "host_record_sha256",
    "client_record_sha256",
    "session_record_sha256",
    "payload_sha256",
    "score",
    "state",
    "promotion_safe",
    "gates",
    "signer_key_ids",
    "signer_principal_ids",
    "signer_organization_ids"
  ],
  "properties": {
    "$schema": { "const": "https://leaguebridge.dev/schemas/readiness-promotion-v4.schema.json" },
    "schema_version": { "const": 4 },
    "evidence_type": { "const": "validation-evidence-v2" },
    "promotion_boundary": { "const": "readiness-schema-v4" },
    "set_id": { "type": "string", "pattern": "^set-[a-f0-9]{32}$" },
    "validation_run_id": { "type": "string", "pattern": "^run-[a-f0-9]{32}$" },
    "route_id": { "enum": ["physical-windows-remote", "physical-macos-remote"] },
    "test_profile_id": { "const": "remote-play-v1" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "created_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "expires_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "manifest_as_of": { "$ref": "#/$defs/canonicalDate" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "host_platform": { "enum": ["windows", "macos"] },
    "host_architecture": { "enum": ["amd64", "arm64"] },
    "client_platform": { "enum": ["linux", "freebsd", "openbsd", "netbsd", "dragonflybsd"] },
    "client_architecture": { "enum": ["amd64", "arm64"] },
    "host_record_sha256": { "$ref": "#/$defs/sha256" },
    "client_record_sha256": { "$ref": "#/$defs/sha256" },
    "session_record_sha256": { "$ref": "#/$defs/sha256" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "score": { "const": 100 },
    "state": { "const": "validated" },
    "promotion_safe": { "const": true },
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/physicalHostGate" },
        { "$ref": "#/$defs/clientRuntimeGate" },
        { "$ref": "#/$defs/sessionQualityGate" },
        { "$ref": "#/$defs/gameplayInteractionGate" }
      ],
      "items": false
    },
    "signer_key_ids": { "$ref": "#/$defs/signerList" },
    "signer_principal_ids": { "$ref": "#/$defs/signerList" },
    "signer_organization_ids": { "$ref": "#/$defs/signerList" }
  },
  "$defs": {
    "canonicalDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signerList": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "passed"],
      "properties": {
        "id": { "type": "string" },
        "weight": { "const": 25 },
        "passed": { "const": true }
      }
    },
    "physicalHostGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        { "properties": { "id": { "const": "physical-host" } } }
      ]
    },
    "clientRuntimeGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        { "properties": { "id": { "const": "client-runtime" } } }
      ]
    },
    "sessionQualityGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        { "properties": { "id": { "const": "session-quality" } } }
      ]
    },
    "gameplayInteractionGate": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        { "properties": { "id": { "const": "gameplay-interaction" } } }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "route_id": { "const": "physical-windows-remote" } },
        "required": ["route_id"]
      },
      "then": {
        "properties": {
          "host_platform": { "const": "windows" },
          "host_architecture": { "const": "amd64" }
        }
      }
    },
    {
      "if": {
        "properties": { "route_id": { "const": "physical-macos-remote" } },
        "required": ["route_id"]
      },
      "then": {
        "properties": {
          "host_platform": { "const": "macos" },
          "host_architecture": { "enum": ["amd64", "arm64"] }
        }
      }
    },
    {
      "if": {
        "properties": { "client_platform": { "const": "dragonflybsd" } },
        "required": ["client_platform"]
      },
      "then": {
        "properties": { "client_architecture": { "const": "amd64" } }
      }
    }
  ]
}
